{
    "name": "infrangible/m2-catalog-product-preselect",
    "description": "Automatically preselects a variant of configurable products on product pages and in product lists: the first one, the cheapest or the most expensive.",
    "type": "magento2-module",
    "version": "2.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Catalog",
        "Product options",
        "Hyvä",
        "preselect configurable product variant",
        "preselect cheapest variant",
        "default variant for configurable products"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-catalog-product-preselect",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~101.0.0|~102.0.0|~103.0.0",
        "infrangible/m2-foundation": "~2.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogProductPreselect\\": "src"
        }
    }
}
